# OpenAI API Configuration
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"

# Cost-Aware Model Routing
# Selectable Fast Models: gpt-4o-mini, gpt-4.1-mini, gpt-4.1-nano, o4-mini (or alias gpt-6-luna)
# Selectable Reasoning Models: gpt-4o, gpt-4.1, o3-mini, o3 (or alias gpt-6.2-sol)
FAST_MODEL="gpt-4o-mini"
REASONING_MODEL="gpt-4o"

# Pricing per 1M tokens (USD) for Real-Time Cost Observability
FAST_MODEL_INPUT_COST_PER_1M="0.15"
FAST_MODEL_OUTPUT_COST_PER_1M="0.60"
REASONING_MODEL_INPUT_COST_PER_1M="2.50"
REASONING_MODEL_OUTPUT_COST_PER_1M="10.00"

# Scraper Settings
HTTP_TIMEOUT_SECONDS="15"
MAX_SCRAPE_CHARS="6000"
